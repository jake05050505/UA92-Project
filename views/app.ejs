<!DOCTYPE html>
<html lang="en-gb" class="dark h-full">
<head>
  <title>Credibility Analysis tool: Home</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="css/styles.css">
  <link rel="stylesheet" href="css/tailwind.css">

  <script>
    // setTimeout(() => {
    //   window.location.reload(1);
    // }, 3*1000);
  </script>
</head>

<body class="flex flex-col h-full">
  <%- include("partials/header.ejs") %>

    <main class="h-full">
      <div id="main-content" class="content h-full flex flex-col flex-1">
        <% if (NO_API_KEY) { %>
          <h3 class="text-red-500">Please check your API Key configuration to use this app</h3>
          <h4 class="text-red-500">ERR: NO_API_KEY</h4>
          <p>See <a target="_blank" href="https://github.com/jake05050505/UA92-Project/blob/main/README.md#:~:text=Environment">README.md</a> for more information about setting up your OpenAI API key.</p>
        <% } else { %>
          <div id="response" class="grid min-h-0 gap-2 p-1 flex-none">
            <div id="message-box" class="container rounded-3xl rounded-b-md rounded-r-md">
              <div id="controls" class="border-b-2 border-border rounded-2xl p-2">
                <a class="text-xl px-2" href="/clear">Clear Chat</a>
              </div>
              <div id="message-contents" class="px-8 py-2">
                <% if ( typeof message !== "undefined" ) { %>
                  <p><%= message %></p>
                <% } %>
                <% if ( typeof error !== "undefined" ) { %>
                  <p class="text-red-500"><%= error %></p>
                <% } %>
              </div>
            </div>
            <div id="statistics" class="container rounded-3xl rounded-b-md rounded-l-md">
              <% if ( typeof statistics !== "undefined" ) { %>
                <div id="agree">
                  <details>
                    <summary>
                      <h4>
                        Supporting Sources:
                      </h4>
                    </summary>

                    <% for (let source of statistics.supporting_sources) { %>
                      <a target="_blank" href="<%= source %>" class="text-sm"> <!-- Potentially unsafe? -->
                        <%= source %>
                      </a>
                      <br>
                    <% } %>

                  </details>
                </div>
                <br />
                <hr />
                <br />
                <div id="disagree">
                  <details>
                    <summary>
                      <h4>
                        Conflicting sources:
                      </h4>
                    </summary>

                    <% for (let source of statistics.conflicting_sources) { %>
                      <a target="_blank" href="<%= source %>" class="text-sm"> <!-- Potentially unsafe? -->
                        <%= source %>
                      </a>
                      <br>
                    <% } %>

                  </details>
                </div>
                <br>
                <hr>
                <br>
                <div id="consensus">
                  <h4>The general consensus for your prompt is:</h4>
                  <% const consensus=statistics.consensus_level %>
                  <% if ( consensus> 0.80 ) { %>
                    <p class="text-green-500 text-3xl">High: <%= consensus.toFixed(2) %></p>
                  <% } else if (consensus> 0.30 ) { %>
                    <p class="text-yellow-500 text-3xl">Mixed: <%= consensus.toFixed(2) %></p>
                  <% } else if (consensus <=0.30 && consensus>= 0) { %>
                    <p class="text-red-500 text-3xl">Low: <%= consensus.toFixed(2) %></p>
                  <% } else { %>
                    <p class="text-3xl text-gray-500">Unclear</p>
                  <% } %>
                </div>
              <% } %>
            </div>
          </div>
          <div id="request" class="content h-auto w-full p-1">
            <form id="query" name="query" action="/" method="POST">
              <div id="input-container" class="flex flex-row container rounded-b-3xl rounded-t-md">
                <input type="text" name="chat_message" id="chat_message" class="w-11/12 min-h-24 py-1 px-4 mb-0"
                  <% if ( typeof placeholder_text !== "undefined" ) { %>
                    placeholder="<%= placeholder_text %>"
                  <% } %>
                />
                <button type="submit" class="hidden"></button>
                <div id="loader" style="visibility: hidden;"></div>
              </div>
              <span id="prompt_length" class="min-h-4 pl-4 mt-0">&ThickSpace;</span>
              <script>
                const input = document.getElementById("chat_message");
                const prompt_length = document.getElementById("prompt_length");

                input.addEventListener("input", () => {
                  prompt_length.textContent = `${input.value.length}/300`;

                  if (input.value.length > 300) {
                    prompt_length.style.color = "red";
                  } else if (input.value.length > 250) {
                    prompt_length.style.color = "orange";
                  } else if (input.value.length > 0) {
                    prompt_length.style.color = "white";
                  } else {
                    prompt_length.style.color = "grey";
                  }
                });

                const form = document.getElementById("query");
                const loader = document.getElementById("loader");
                const message_box = document.getElementById("input-container");

                form.addEventListener("submit", (submitEvent) => {
                  submitEvent.preventDefault();
                  if (input.value.length <= 300){
                    loader.setAttribute("style", "visibility: visible;");
                    form.submit();
                  } else {
                    message_box.classList.add("error");
                    setTimeout(() => {
                      message_box.classList.remove("error");
                    },1*1000);
                  }
                });
              </script>
            </form>
          </div>
        <% } %>
      </div>
    </main>

    <footer class="border-accent border-t-2 h-auto w-full">
      <div class="py-3 text-center" id="disclaimer">
        <p>Built with Express.js, uses GPT-5-mini; AI can make mistakes, double-check important info.</p>
        <p class="text-yellow-500">Caution: Do not enter any sensitive information.</p>
        <% if (DEV_MODE) { %>
          <p>
            <span>Environment: development; </span><span class="text-red-500">the server host can see your messages.</span>
          </p>
        <% } %>
      </div>
    </footer>
</body>
</html>